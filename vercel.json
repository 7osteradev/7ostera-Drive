{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/login",
      "dest": "server/index.js"
    },
    {
      "src": "/register",
      "dest": "server/index.js"
    },
    {
      "src": "/dashboard",
      "dest": "server/index.js"
    },
    {
      "src": "/share/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
