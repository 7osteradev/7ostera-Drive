# ─────────────────────────────────────────────
# 7ostera Drive — Environment Configuration
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development   # set to 'production' for HTTPS-only cookies

# ─── SECURITY KEYS (REQUIRED IN PRODUCTION) ───
# Generate ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_GENERATED_ABOVE

# Generate JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ─── Storage ───────────────────────────────────
# Max upload size per file in MB (default: 500)
MAX_FILE_SIZE_MB=500

# Per-user storage quota in bytes (default: 5 GB)
# 5368709120 = 5 * 1024 * 1024 * 1024
# STORAGE_LIMIT_BYTES=5368709120
